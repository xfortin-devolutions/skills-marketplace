#!/bin/bash
# Fake claude for tests/run-loop.test.sh: plays one agent session from the scenario. The role comes from the prompt;
# the scenario ($FAKE_SCENARIO) defines <role>_<n> (the role's n-th session) or <role>, else the defaults in agents.sh
# run. A function's stdout is the session's result; returning 142 plays a time box (no result line, like a kill).
prompt="" prev=""
for a in "$@"; do [ "$prev" = -p ] && prompt=$a; prev=$a; done
[ "$1" = --version ] && { echo "0.0.0 (fake)"; exit 0; }
case "$prompt" in
  "You are the builder"* | "The loop's runner sent"*) role=builder ;;
  "Review the change"*) role=reviewer ;;
  "QA for ticket"*) role=qa ;;
  "Write the exploratory test charter"*) role=charter ;;
  "Job: Explore"*) role=explorer ;;
  "Job: Recheck"*) role=recheck ;;
  "Assess ticket"*) role=assessor ;;
  "Write the pull request for ticket"*) role=pr ;;
  *) role=unknown ;;
esac
n=$(($(cat "$FAKE_STATE/$role.n" 2> /dev/null || echo 0) + 1))
echo "$n" > "$FAKE_STATE/$role.n"
echo "$role $n" >> "$FAKE_STATE/calls.log"
printf '%s\n' "$prompt" > "$FAKE_STATE/$role-$n.prompt"
. "$(dirname "$0")/../agents.sh"
[ -f "${FAKE_SCENARIO:-}" ] && . "$FAKE_SCENARIO"
f=${role}_$n
type "$f" > /dev/null 2>&1 || f=$role
out=$("$f" 2>> "$FAKE_STATE/agents.err")
rc=$?
[ $rc -eq 142 ] && exit 142
jq -cn --arg r "$out" '{type: "result", subtype: "success", num_turns: 1, total_cost_usd: 0.5, permission_denials: [], result: $r}'
