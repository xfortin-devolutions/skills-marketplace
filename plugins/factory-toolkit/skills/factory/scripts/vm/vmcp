#!/bin/bash
# Copies a folder from the Mac into the guest, over SSH like vmssh (same VM_SSH_PORT, VM_KNOWN_HOSTS, FACTORY_VM_HOME).
#   vmcp <local folder> <guest folder>      e.g. vmcp ~/.factory/provided/lab 'C:\factory\provided\lab'
# The guest folder is replaced. Lock folders (.in-use.d) stay behind. Prints nothing of the files' contents.
set -uo pipefail
src=${1:?usage: vmcp <local folder> <guest folder>} dst=${2:?usage: vmcp <local folder> <guest folder>}
[ -d "$src" ] || { echo "vmcp: no folder $src" >&2; exit 2; }
VM_HOME="${FACTORY_VM_HOME:-$HOME/VMs/factory/windows}"
OPTS=(-i "$VM_HOME/id_ed25519" -o UserKnownHostsFile="${VM_KNOWN_HOSTS:-$VM_HOME/known_hosts}"
      -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o LogLevel=ERROR)
stage=$(mktemp -d) && trap 'rm -rf "$stage"' EXIT
name=$(basename "$dst" | tr '\\' '/' | awk -F/ '{print $NF}')
rsync -a --exclude .in-use.d "$src/" "$stage/$name/"
# The parent folder exists and the target doesn't; scp then creates it from the staged copy.
parent=${dst%\\*}
"$(dirname "$0")/vmssh" "Remove-Item -Recurse -Force '$dst' -ErrorAction SilentlyContinue; New-Item -ItemType Directory -Force '$parent' | Out-Null" > /dev/null || exit 1
# Windows' OpenSSH serves SFTP paths as /C:/...
scp -q -r -P "${VM_SSH_PORT:-2222}" "${OPTS[@]}" "$stage/$name" "rdmtest@127.0.0.1:/$(echo "$parent" | tr '\\' '/')/"
