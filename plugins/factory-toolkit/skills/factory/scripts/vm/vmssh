#!/bin/bash
# Runs PowerShell in the guest over SSH, with R: (the shared worktree) mapped first.
#   vmssh 'Get-Process'                         inline command
#   vmssh - < script.ps1                        script from stdin, sent as -EncodedCommand (no quoting issues)
# Which VM: VM_SSH_PORT and VM_KNOWN_HOSTS (set by vmctl.sh env <run dir>) and FACTORY_VM_HOME (the golden image
# folder, which holds the guest key); without them, the single VM of the original rdm-windows-vm-test setup.
set -uo pipefail

VM_HOME="${FACTORY_VM_HOME:-$HOME/VMs/factory/windows}"
SSH=(ssh -i "$VM_HOME/id_ed25519" -p "${VM_SSH_PORT:-2222}" -o UserKnownHostsFile="${VM_KNOWN_HOSTS:-$VM_HOME/known_hosts}"
     -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o LogLevel=ERROR -o ServerAliveInterval=30 rdmtest@127.0.0.1)

# SSH sessions don't inherit the desktop's drive mappings, so every call maps R: itself. QEMU starts the host's smbd on
# the guest's first connection, which can take seconds (longer with two VMs booting): retry for up to 60 s.
PRELUDE='$ProgressPreference = "SilentlyContinue"; for ($i = 0; $i -lt 30 -and -not (Test-Path R:\); $i++) { net use R: \\10.0.2.4\qemu 2>&1 | Out-Null; if (-not (Test-Path R:\)) { Start-Sleep 2 } }'
if [ "${1:-}" = "-" ]; then
    BODY="$(cat)"
else
    BODY="$*"
fi

ENC=$(printf '%s\n%s\n' "$PRELUDE" "$BODY" | iconv -f UTF-8 -t UTF-16LE | base64 | tr -d '\n')
# PowerShell sends its error stream as CLIXML over a non-interactive session: keep the messages, drop the markup.
"${SSH[@]}" "powershell -NoProfile -NonInteractive -EncodedCommand $ENC" 2>&1 \
    | perl -ne 'next if /^#< CLIXML/; if (/^<Objs Version=/) { my @e = /<S S="Error">(.*?)<\/S>/g; next unless @e;
        $_ = "PS ERROR: " . join("", @e) . "\n"; s/_x000D__x000A_/ /g; s/_x000A_/ /g } print'
exit "${PIPESTATUS[0]}"
